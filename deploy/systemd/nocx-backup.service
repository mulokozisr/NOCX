[Unit]
Description=Encrypted NOC-X backup to DOXA
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/nocx/backup.env
ExecStart=/usr/local/sbin/nocx-backup
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nocx-backup /var/lib/nocx
Environment=RESTIC_CACHE_DIR=/var/lib/nocx-backup/cache
TimeoutStartSec=45min
